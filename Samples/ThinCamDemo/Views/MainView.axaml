<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:tc="using:ThinCam.Avalonia"
             xmlns:vm="using:ThinCamDemo.ViewModels"
             x:Class="ThinCamDemo.Views.MainView"
             x:DataType="vm:MainViewModel"
             mc:Ignorable="d"
             d:DesignWidth="900"
             d:DesignHeight="700"
             TopLevel.AutoSafeAreaPadding="True">
    <Grid RowDefinitions="Auto,*" Margin="{OnFormFactor Desktop='12', Mobile='8'}">
        <Border Classes="card" Margin="0,0,0,10">
            <Grid ColumnDefinitions="{OnFormFactor Desktop='*,Auto', Mobile='*'}"
                  RowDefinitions="{OnFormFactor Desktop='Auto,Auto', Mobile='Auto,Auto,Auto'}">
                <StackPanel>
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="ThinCam" />
                    <TextBlock Opacity="0.7" Text="{Binding PlatformDescription}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Row="{OnFormFactor Desktop=0, Mobile=1}"
                            Grid.Column="{OnFormFactor Desktop=1, Mobile=0}"
                            Margin="{OnFormFactor Desktop='12,0,0,0', Mobile='0,8,0,0'}"
                            HorizontalAlignment="{OnFormFactor Desktop=Right, Mobile=Left}">
                    <TextBlock FontWeight="SemiBold" Text="{Binding StatusText}" TextWrapping="Wrap" />
                    <TextBlock Opacity="0.7" Text="{Binding ActiveFormatText}" TextWrapping="Wrap" />
                    <ComboBox x:Name="ThemeSelector"
                              Margin="0,8,0,0"
                              MinWidth="140"
                              SelectionChanged="OnThemeSelectionChanged">
                        <ComboBoxItem Content="System theme" />
                        <ComboBoxItem Content="Light theme" />
                        <ComboBoxItem Content="Dark theme" />
                    </ComboBox>
                </StackPanel>
                <TextBlock Grid.Row="{OnFormFactor Desktop=1, Mobile=2}"
                           Grid.ColumnSpan="2"
                           Margin="0,8,0,0"
                           IsVisible="{Binding HasError}"
                           Foreground="#D95C5C"
                           Text="{Binding LastError}"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>

        <TabControl Grid.Row="1">
            <TabItem Header="Capture">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="10" Margin="4">
                        <Border Classes="card" Padding="0">
                            <Grid RowDefinitions="*,Auto" MinHeight="320">
                                <tc:CameraPreview x:Name="Preview"
                                                  Source="{Binding PreviewSource}"
                                                  Stretch="Uniform"
                                                  CornerRadius="8,8,0,0"
                                                  PlaceholderContent="Open a camera to start preview"
                                                  FrameRendered="OnPreviewFrameRendered" />
                                <Border Grid.Row="1"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="0,1,0,0"
                                        CornerRadius="0,0,8,8"
                                        Padding="12,8">
                                    <WrapPanel ItemSpacing="16" LineSpacing="8">
                                        <StackPanel>
                                            <TextBlock Classes="label" Text="Received FPS" />
                                            <TextBlock FontWeight="SemiBold"
                                                       Text="{Binding ReceivedFramesPerSecond, StringFormat={}{0:0.0}}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Classes="label" Text="Rendered FPS" />
                                            <TextBlock FontWeight="SemiBold"
                                                       Text="{Binding RenderedFramesPerSecond, StringFormat={}{0:0.0}}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Classes="label" Text="Frames" />
                                            <TextBlock FontWeight="SemiBold" Text="{Binding TotalFrames}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Classes="label" Text="Last frame" />
                                            <TextBlock FontWeight="SemiBold" Text="{Binding LastFrameAge}" />
                                        </StackPanel>
                                        <Button Classes="accent"
                                                HorizontalAlignment="Right"
                                                Command="{Binding SaveSnapshotCommand}"
                                                Content="Save snapshot" />
                                    </WrapPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Classes="card">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="section-title" Text="Permission and device" />
                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="10"
                                      RowSpacing="8">
                                    <TextBlock Classes="label" Text="Permission" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold"
                                                   Text="{Binding PermissionStatusText}" />
                                        <Button Command="{Binding RequestPermissionCommand}"
                                                Content="Request permission" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Classes="label" Text="Camera" />
                                    <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <ComboBox ItemsSource="{Binding Devices}"
                                                  SelectedItem="{Binding SelectedDevice}"
                                                  HorizontalAlignment="Stretch" />
                                        <Button Grid.Column="1" Command="{Binding RefreshDevicesCommand}"
                                                Content="Refresh" />
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="card">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="section-title" Text="Capture request" />
                                <UniformGrid Columns="{OnFormFactor Desktop=4, Mobile=2}"
                                             Rows="{OnFormFactor Desktop=1, Mobile=2}">
                                    <StackPanel Margin="0,0,8,8">
                                        <TextBlock Classes="label" Text="Width" />
                                        <NumericUpDown Value="{Binding RequestedWidth}" Minimum="1" Maximum="7680"
                                                       Increment="1" FormatString="0" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,8">
                                        <TextBlock Classes="label" Text="Height" />
                                        <NumericUpDown Value="{Binding RequestedHeight}" Minimum="1" Maximum="4320"
                                                       Increment="1" FormatString="0" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,8">
                                        <TextBlock Classes="label" Text="FPS" />
                                        <NumericUpDown Value="{Binding RequestedFramesPerSecond}" Minimum="1"
                                                       Maximum="240" Increment="1" FormatString="0" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Classes="label" Text="Queue" />
                                        <NumericUpDown Value="{Binding QueueCapacity}" Minimum="1" Maximum="32"
                                                       Increment="1" FormatString="0" />
                                    </StackPanel>
                                </UniformGrid>
                                <WrapPanel ItemSpacing="8" LineSpacing="8" Margin="0,4,0,0">
                                    <Button Command="{Binding OpenCameraCommand}" Content="Open" />
                                    <Button Command="{Binding CloseCameraCommand}" Content="Close" />
                                    <Button Command="{Binding RestartCameraCommand}" Content="Restart" />
                                    <Button Command="{Binding RefreshCapabilitiesCommand}"
                                            Content="Refresh capabilities" />
                                    <Button Command="{Binding RefreshControlStateCommand}"
                                            Content="Refresh control state" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Classes="card">
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12"
                                  RowSpacing="4">
                                <TextBlock Classes="label" Text="Rendered frames" />
                                <TextBlock Grid.Column="1" Text="{Binding RenderedFrames}" />
                                <TextBlock Grid.Row="1" Classes="label" Text="Preview frames skipped" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PreviewFramesSkipped}" />
                                <TextBlock Grid.Row="2" Classes="label" Text="Active format" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ActiveFormatText}"
                                           TextWrapping="Wrap" />
                                <TextBlock Grid.Row="3" Classes="label" Text="Selected device ID" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedDeviceId}"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Controls">
                <tc:CameraControlsView Camera="{Binding ActiveCamera}"
                                       ErrorOccurred="OnControlError"
                                       StatusChanged="OnControlStatus"
                                       Margin="4" />
            </TabItem>

            <TabItem Header="Diagnostics">
                <Grid RowDefinitions="Auto,*" Margin="4">
                    <WrapPanel ItemSpacing="8" LineSpacing="8" Margin="0,0,0,8">
                        <Button Command="{Binding ExportDiagnosticsCommand}" Content="Export report" />
                        <Button Command="{Binding ClearLogCommand}" Content="Clear log" />
                        <Button Command="{Binding RefreshDevicesCommand}" Content="Re-enumerate" />
                        <Button Command="{Binding RefreshCapabilitiesCommand}" Content="Read capabilities" />
                    </WrapPanel>
                    <TextBox Grid.Row="1" Text="{Binding DiagnosticText}"
                             IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                             FontFamily="monospace"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>