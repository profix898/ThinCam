<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest Condition="$([MSBuild]::IsOSPlatform('Windows'))">app.manifest</ApplicationManifest>
    <ThinCamDemoRuntimeIdentifier Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</ThinCamDemoRuntimeIdentifier>
    <ThinCamDemoRuntimeIdentifier Condition="'$(ThinCamDemoRuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</ThinCamDemoRuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.150.1" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
    <ProjectReference Include="../ThinCamDemo/ThinCamDemo.csproj" AdditionalProperties="ThinCamTargetFrameworks=net8.0" />
  </ItemGroup>

  <ItemGroup Condition="Exists('../../Sources/ThinCam/runtimes/$(ThinCamDemoRuntimeIdentifier)/native')">
    <Content Include="../../Sources/ThinCam/runtimes/$(ThinCamDemoRuntimeIdentifier)/native/*"
             Link="%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
