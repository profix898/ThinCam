<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(ThinCamTargetFrameworks)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>12</LangVersion>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>ThinCam</PackageId>
    <Description>Thin, platform-native camera frame capture and camera controls for .NET.</Description>
    <Authors>ThinCam contributors</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <PackageTags>camera;webcam;capture;controls;exposure;focus;zoom;v4l2;media-foundation;avfoundation;camera2</PackageTags>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <PropertyGroup>
    <ThinCamRuntimeRoot>$(MSBuildThisFileDirectory)../../Build/Native/runtimes/</ThinCamRuntimeRoot>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../Build/ThinCam.targets" Pack="true" PackagePath="buildTransitive/ThinCam.targets" />
    <None Include="$(ThinCamRuntimeRoot)**/*" Pack="true" PackagePath="runtimes/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    On Windows the native library name (thincam.dll) differs only by case from the
    managed assembly (ThinCam.dll). On a case-insensitive filesystem they collide in
    the output root. Copy the native binaries into runtimes/<RID>/native/ subdirectories
    using Content+Link, so the DllImportResolver in NativeHelpers finds them without
    overwriting the managed assembly.
  -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == ''">
    <Content Include="$(ThinCamRuntimeRoot)win-x64/native/thincam.dll"
             Pack="false"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Link="runtimes\win-x64\native\thincam.dll"
             Condition="Exists('$(ThinCamRuntimeRoot)win-x64/native/thincam.dll')" />
    <Content Include="$(ThinCamRuntimeRoot)win-arm64/native/thincam.dll"
             Pack="false"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Link="runtimes\win-arm64\native\thincam.dll"
             Condition="Exists('$(ThinCamRuntimeRoot)win-arm64/native/thincam.dll')" />
    <Content Include="$(ThinCamRuntimeRoot)linux-x64/native/libthincam.so"
             Pack="false"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Link="runtimes\linux-x64\native\libthincam.so"
             Condition="Exists('$(ThinCamRuntimeRoot)linux-x64/native/libthincam.so')" />
    <Content Include="$(ThinCamRuntimeRoot)osx-x64/native/libthincam.dylib"
             Pack="false"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Link="runtimes\osx-x64\native\libthincam.dylib"
             Condition="Exists('$(ThinCamRuntimeRoot)osx-x64/native/libthincam.dylib')" />
    <Content Include="$(ThinCamRuntimeRoot)osx-arm64/native/libthincam.dylib"
             Pack="false"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Link="runtimes\osx-arm64\native\libthincam.dylib"
             Condition="Exists('$(ThinCamRuntimeRoot)osx-arm64/native/libthincam.dylib')" />
  </ItemGroup>

  <!--
    The .NET Android SDK globs **/*.so into AndroidNativeLibrary. The staged
    runtimes/ tree is not laid out by Android ABI, so the globbed items are
    removed here and re-added with explicit Abi metadata by ThinCam.targets.
  -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <AndroidNativeLibrary Remove="$(ThinCamRuntimeRoot)**/*.so" />
  </ItemGroup>
  <Import Project="../../Build/ThinCam.targets" Condition="Exists('../../Build/ThinCam.targets')" />
</Project>
